---
import AdminNav from "~/components/AdminNav.astro";
import "~/styles/foglio.css";
import "~/styles/admin-foglio.css";
import "~/styles/admin-analytics.css";

export const prerender = false;

if (!Astro.locals.isAdmin) {
  return new Response("Unauthorized", { status: 401 });
}

const TABS = [
  { id: "panoramica", label: "Panoramica" },
  { id: "utenti", label: "Utenti" },
  { id: "acquisizione", label: "Acquisizione" },
  { id: "coinvolgimento", label: "Coinvolgimento" },
  { id: "tecnologia", label: "Tecnologia" },
  { id: "bot", label: "Bot & qualità" },
];
const PERIODS = [
  { id: "today", label: "Oggi" },
  { id: "7d", label: "7g" },
  { id: "30d", label: "30g" },
  { id: "90d", label: "90g" },
  { id: "12m", label: "12m" },
];
const CHANNELS = ["direct", "search", "social", "ai", "email", "referral", "campaign"];
const LEGACY_HINT = "Sistema vecchio: sostituito da verdetto e regole bot, verrà rimosso dopo il periodo di confronto";
---

<!doctype html>
<html lang="it" class="foglio" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>Analytics · Admin</title>
  </head>
  <body class="admin">
    <AdminNav currentPage="analytics" />

    <div class="ax" id="ax">
      <header class="ax-bar" id="ax-bar">
        <div class="ax-bar-row">
          <h1 class="ax-title"><em class="acc">Analytics.</em></h1>
          <button type="button" class="ax-live-pill" id="live-pill" aria-label="Utenti online ora: vai alla Panoramica">
            <span class="ax-live-dot" aria-hidden="true"></span><span id="live-count">—</span> ora
          </button>
          <button type="button" class="ax-btn ax-filters-toggle" id="filters-toggle" aria-expanded="false" aria-controls="filters-panel">
            Filtri <span id="filters-count" class="chip info" hidden></span>
          </button>
        </div>

        <div class="ax-bar-row">
          <div class="ax-seg" role="group" aria-label="Periodo" id="periods">
            {PERIODS.map((p) => <button type="button" data-period={p.id} aria-pressed="false">{p.label}</button>)}
            <button type="button" data-period="custom" aria-pressed="false" aria-controls="custom-range" aria-expanded="false">Date</button>
          </div>
          <div class="ax-seg" role="group" aria-label="Sposta il periodo">
            <button type="button" id="nav-prev" aria-label="Periodo precedente">‹</button>
            <button type="button" id="nav-next" aria-label="Periodo successivo">›</button>
          </div>
          <span class="ax-range-label" id="range-label" aria-live="polite">—</span>
          <div class="ax-custom" id="custom-range">
            <label class="ax-vh" for="date-from">Dal</label><input type="date" id="date-from" />
            <label class="ax-vh" for="date-to">Al</label><input type="date" id="date-to" />
            <button type="button" class="ax-btn primary" id="date-go">Applica</button>
          </div>
        </div>

        <div class="ax-filters-panel" id="filters-panel" role="group" aria-label="Filtri globali">
          <label>Paese <select id="f-country"><option value="">Tutti</option></select></label>
          <label>Device
            <select id="f-device">
              <option value="">Tutti</option><option value="mobile">mobile</option>
              <option value="tablet">tablet</option><option value="desktop">desktop</option>
            </select>
          </label>
          <label>Canale
            <select id="f-channel">
              <option value="">Tutti</option>
              {CHANNELS.map((c) => <option value={c}>{c}</option>)}
            </select>
          </label>
          <button type="button" class="ax-btn" id="f-reset" hidden>Azzera filtri</button>
          <div class="ax-fresh" id="data-source-note">
            <span>Aggiornamento dati: <span id="data-source">—</span></span>
            <button type="button" class="ax-btn" id="rollup-recalc" title="Ricalcola gli aggregati giornalieri del periodo (esclude oggi)">Ricalcola aggregati</button>
            <span id="rollup-status" role="status" aria-live="polite"></span>
          </div>
        </div>
        <p class="ax-notice" id="filter-note" role="status" hidden></p>

        <div class="ax-tabs" role="tablist" aria-label="Sezioni analytics" id="tabs">
          {TABS.map((t) => (
            <button type="button" role="tab" id={`tab-${t.id}`} data-tab={t.id} aria-controls={`panel-${t.id}`} aria-selected="false" tabindex="-1">{t.label}</button>
          ))}
        </div>
      </header>

      <main id="ax-main">
        <div class="ax-vh" id="ax-status" role="status" aria-live="polite"></div>

        <!-- ============ PANORAMICA ============ -->
        <section class="ax-panel" role="tabpanel" id="panel-panoramica" aria-labelledby="tab-panoramica" tabindex="0" hidden>
          <div class="ax-grid cols-21">
            <section class="ax-card" aria-labelledby="rt-title">
              <div class="ax-card-head">
                <h2 class="ax-card-title" id="rt-title">In tempo reale</h2>
                <span class="ax-card-meta">ultimi 5 minuti · aggiornato ogni 30 s</span>
              </div>
              <div class="ax-rt" id="rt-body"><div class="ax-skel tall"></div><div class="ax-skel"></div></div>
            </section>
            <section class="ax-card" aria-labelledby="ov-top-title">
              <div class="ax-card-head">
                <h2 class="ax-card-title" id="ov-top-title">Pagine principali</h2>
                <span class="ax-card-meta">utenti · <a class="ax-link" href="#coinvolgimento">Tutte</a></span>
              </div>
              <div id="ov-top"></div>
            </section>
          </div>

          <section aria-label="Indicatori principali">
            <div class="ax-scorecards" id="scorecards"></div>
          </section>

          <section class="ax-card" aria-labelledby="chart-title" style="margin-bottom: var(--ax-gap)">
            <div class="ax-card-head">
              <h2 class="ax-card-title" id="chart-title">Andamento</h2>
              <div class="ax-seg" role="group" aria-label="Metrica del grafico" id="metric-seg">
                <button type="button" data-metric="visitors" aria-pressed="true">Utenti</button>
                <button type="button" data-metric="sessions" aria-pressed="false">Sessioni</button>
                <button type="button" data-metric="pageviews" aria-pressed="false">Pageview</button>
              </div>
              <span class="ax-card-meta"><a class="ax-link ax-export" data-export="daily" href="#" download>Esporta CSV</a></span>
            </div>
            <div id="chart-state"></div>
            <div class="ax-chart-box"><canvas id="chart" role="img" aria-label="Grafico dell'andamento nel tempo"></canvas></div>
          </section>

          <div class="ax-grid cols-3">
            <section class="ax-card" aria-labelledby="ov-ch-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="ov-ch-title">Canali</h2><span class="ax-card-meta">sessioni</span></div>
              <div id="ov-channels"></div>
            </section>
            <section class="ax-card" aria-labelledby="ov-co-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="ov-co-title">Paesi</h2><span class="ax-card-meta" id="geo-meta">—</span></div>
              <div class="ax-map" id="world-map" aria-label="Mappa dei visitatori per paese" role="img"></div>
              <div class="ax-map-legend"><span>0</span><i></i><span id="map-max-label">max</span></div>
              <div id="ov-countries"></div>
            </section>
            <section class="ax-card" aria-labelledby="ov-dev-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="ov-dev-title">Dispositivi</h2><span class="ax-card-meta">utenti</span></div>
              <div id="ov-devices"></div>
            </section>
          </div>
        </section>

        <!-- ============ UTENTI ============ -->
        <section class="ax-panel" role="tabpanel" id="panel-utenti" aria-labelledby="tab-utenti" tabindex="0" hidden>
          <section class="ax-card" aria-labelledby="us-sum-title" style="margin-bottom: var(--ax-gap)">
            <div class="ax-card-head">
              <h2 class="ax-card-title" id="us-sum-title">Chi c'è ora</h2>
              <span class="ax-card-meta">ultimi 5 minuti</span>
            </div>
            <div id="us-summary"></div>
          </section>

          <div class="ax-seg-wrap">
            <div class="ax-seg" role="group" aria-label="Tipo di visitatore" id="verdict-seg">
              <button type="button" data-verdict="human" aria-pressed="true">Solo umani</button>
              <button type="button" data-verdict="all" aria-pressed="false">Tutti</button>
              <button type="button" data-verdict="unverified" aria-pressed="false">Non verificati</button>
              <button type="button" data-verdict="bot" aria-pressed="false">Bot</button>
            </div>
            <label class="ax-check"><input type="checkbox" id="us-events" /> Solo con eventi</label>
          </div>

          <section class="ax-card" aria-labelledby="us-list-title">
            <div class="ax-card-head">
              <h2 class="ax-card-title" id="us-list-title">Sessioni recenti</h2>
              <span class="ax-card-meta" id="us-count">una riga = una visita</span>
            </div>
            <div id="us-state"></div>
            <ul class="ax-sess-list" id="us-list"></ul>
            <div class="ax-more"><button type="button" class="ax-btn" id="us-more" hidden>Carica altre</button></div>
            <p class="ax-privacy">Gli identificativi (“Utente #a1b2c3”) sono anonimi e cambiano ogni giorno: chi torna il giorno dopo compare come un nuovo utente. Nessun IP è mostrato o conservato.</p>
          </section>
        </section>

        <!-- ============ ACQUISIZIONE ============ -->
        <section class="ax-panel" role="tabpanel" id="panel-acquisizione" aria-labelledby="tab-acquisizione" tabindex="0" hidden>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="aq-ch-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="aq-ch-title">Canali</h2><span class="ax-card-meta">sessioni per canale <a class="ax-link ax-export" data-export="channels" href="#" download>CSV</a></span></div>
              <div id="aq-channels"></div>
            </section>
            <section class="ax-card" aria-labelledby="aq-ref-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="aq-ref-title">Referrer</h2><span class="ax-card-meta">utenti <a class="ax-link ax-export" data-export="referrers" href="#" download>CSV</a></span></div>
              <div id="aq-referrers"></div>
            </section>
          </div>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="aq-src-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="aq-src-title">UTM · sorgenti</h2><span class="ax-card-meta"><a class="ax-link ax-export" data-export="utm" href="#" download>CSV</a></span></div>
              <div id="aq-utm-sources"></div>
            </section>
            <section class="ax-card" aria-labelledby="aq-cmp-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="aq-cmp-title">UTM · campagne</h2></div>
              <div id="aq-utm-campaigns"></div>
            </section>
          </div>
          <section class="ax-card" aria-labelledby="aq-land-title">
            <div class="ax-card-head">
              <h2 class="ax-card-title" id="aq-land-title">Pagine di ingresso per canale</h2>
              <label class="ax-card-meta">Canale
                <select id="landing-channel" aria-label="Canale delle pagine di ingresso">
                  <option value="">Tutti</option>
                  {CHANNELS.map((c) => <option value={c}>{c}</option>)}
                </select>
              </label>
            </div>
            <div id="aq-landing"></div>
          </section>
        </section>

        <!-- ============ COINVOLGIMENTO ============ -->
        <section class="ax-panel" role="tabpanel" id="panel-coinvolgimento" aria-labelledby="tab-coinvolgimento" tabindex="0" hidden>
          <section class="ax-card" aria-labelledby="en-pages-title" style="margin-bottom: var(--ax-gap)">
            <div class="ax-card-head"><h2 class="ax-card-title" id="en-pages-title">Pagine principali</h2><span class="ax-card-meta">tempo e scroll solo per i post <a class="ax-link ax-export" data-export="top_pages" href="#" download>CSV</a></span></div>
            <div id="en-pages"></div>
          </section>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="en-sec-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="en-sec-title">Sezioni</h2><span class="ax-card-meta">dove leggono</span></div>
              <div id="en-sections"></div>
            </section>
            <section class="ax-card" aria-labelledby="en-eng-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="en-eng-title">Post più letti</h2><span class="ax-card-meta">engagement = tempo × scroll</span></div>
              <div id="en-engaged"></div>
            </section>
          </div>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="en-entry-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="en-entry-title">Pagine di ingresso</h2><span class="ax-card-meta">prima pagina della sessione</span></div>
              <div id="en-entry"></div>
            </section>
            <section class="ax-card" aria-labelledby="en-exit-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="en-exit-title">Pagine di uscita</h2><span class="ax-card-meta">ultima pagina della sessione</span></div>
              <div id="en-exit"></div>
            </section>
          </div>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="en-ev-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="en-ev-title">Eventi</h2><span class="ax-card-meta">azioni anonime <a class="ax-link ax-export" data-export="events" href="#" download>CSV</a></span></div>
              <div id="en-events"></div>
            </section>
            <section class="ax-card" aria-labelledby="en-goal-title">
              <div class="ax-card-head"><h2 class="ax-card-title" id="en-goal-title">Obiettivi</h2><span class="ax-card-meta">conversioni <a class="ax-link ax-export" data-export="goals" href="#" download>CSV</a></span></div>
              <div id="en-goals"></div>
            </section>
          </div>
        </section>

        <!-- ============ TECNOLOGIA ============ -->
        <section class="ax-panel" role="tabpanel" id="panel-tecnologia" aria-labelledby="tab-tecnologia" tabindex="0" hidden>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="te-dev-title"><div class="ax-card-head"><h2 class="ax-card-title" id="te-dev-title">Dispositivi</h2></div><div id="te-devices"></div></section>
            <section class="ax-card" aria-labelledby="te-br-title"><div class="ax-card-head"><h2 class="ax-card-title" id="te-br-title">Browser</h2></div><div id="te-browsers"></div></section>
          </div>
          <div class="ax-grid cols-2">
            <section class="ax-card" aria-labelledby="te-os-title"><div class="ax-card-head"><h2 class="ax-card-title" id="te-os-title">Sistemi operativi</h2></div><div id="te-os"></div></section>
            <section class="ax-card" aria-labelledby="te-lang-title"><div class="ax-card-head"><h2 class="ax-card-title" id="te-lang-title">Lingua</h2></div><div id="te-languages"></div></section>
          </div>
          <h2 class="ax-section-h">Web Vitals</h2>
          <div id="vitals-state"></div>
          <div class="ax-grid cols-3" id="vitals-cards"></div>
          <section class="ax-card" aria-labelledby="te-slow-title">
            <div class="ax-card-head"><h2 class="ax-card-title" id="te-slow-title">Pagine più lente</h2><span class="ax-card-meta">LCP p75 · almeno 5 misure · dati grezzi</span></div>
            <div id="te-slow"></div>
          </section>
        </section>

        <!-- ============ BOT & QUALITÀ ============ -->
        <section class="ax-panel" role="tabpanel" id="panel-bot" aria-labelledby="tab-bot" tabindex="0" hidden>
          <section aria-labelledby="qu-title">
            <h2 class="ax-section-h" id="qu-title" style="margin-top: 0">Qualità traffico</h2>
            <div class="ax-qual" id="quality"></div>
            <p class="ax-qual-note">
              <label class="ax-check"><input type="checkbox" id="include-all" /> Includi non verificati (numeri come prima)</label>
              <span id="q-mode">—</span>
              <span id="q-legacy"></span>
            </p>
          </section>
          <section class="ax-card" aria-labelledby="qu-review-title" style="margin-bottom: var(--ax-gap)">
            <div class="ax-card-head"><h2 class="ax-card-title" id="qu-review-title">Da rivedere</h2><span class="ax-card-meta">non verificati, raggruppati per profilo</span></div>
            <div id="review-box"></div>
          </section>
          <section class="ax-card" aria-labelledby="qu-rules-title" style="margin-bottom: var(--ax-gap)">
            <div class="ax-card-head"><h2 class="ax-card-title" id="qu-rules-title">Regole bot</h2><span class="ax-card-meta">valgono dalle nuove visite</span></div>
            <div id="rules-box"></div>
          </section>
          <section class="ax-card" aria-labelledby="qu-legacy-title">
            <div class="ax-card-head">
              <h2 class="ax-card-title" id="qu-legacy-title">Strumenti legacy <span class="ax-legacy-tag" title={LEGACY_HINT}>legacy</span></h2>
              <span class="ax-card-meta">flag per hash, sostituito dalle regole bot</span>
            </div>
            <p class="ax-qual-note">
              <span>Sospetti (zero engagement): <b id="s-suspects">—</b></span>
              <button type="button" class="ax-btn legacy" id="flag-suspects-btn" hidden title="Legacy: flag per hash, sostituito dalle regole bot">Flag come bot (legacy)</button>
              <button type="button" class="ax-btn legacy" id="flag-all-bots" hidden title="Legacy: flag per hash">Flag zero-engagement (legacy)</button>
              <button type="button" class="ax-btn legacy" id="unflag-recent" title="Legacy: rimuove dai bot gli hash flaggati nelle ultime 24 ore">Annulla flag fatti oggi (legacy)</button>
              <button type="button" class="ax-btn legacy" id="unflag-all" title="Legacy: rimuove TUTTI gli hash dalla bot list (paracadute)">Annulla TUTTI (legacy)</button>
            </p>
            <h3 class="ax-card-title" style="margin: 0.5rem 0">Visitatori recenti <span class="ax-legacy-tag">legacy</span></h3>
            <div id="recent-box"></div>
          </section>
        </section>
      </main>

      <div class="ax-scrim" id="sheet-scrim" hidden></div>
      <aside class="ax-sheet" id="sheet" role="dialog" aria-modal="true" aria-labelledby="sheet-title" hidden tabindex="-1">
        <div class="ax-sheet-head">
          <h2 id="sheet-title">Sessione</h2>
          <button type="button" class="ax-btn" id="sheet-close" aria-label="Chiudi dettaglio">Chiudi</button>
        </div>
        <div id="sheet-body"></div>
      </aside>
    </div>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css" integrity="sha384-b8ANgTJvdlAnWM5YGMpKn7Kodm+1k7NYNG9zdjTCcZcKatzYHwZ0RLdWarbJJVzU" crossorigin="anonymous" />
    <script is:inline src="/admin/admin-client.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js" integrity="sha384-u5N8qJeJOO2iqNjIKTdl6KeKsEikMAmCUBPc6sC6uGpgL34aPJ4VgNhuhumedpEk" crossorigin="anonymous"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous"></script>
    <!-- Dashboard logic: native ES modules under public/admin/analytics/ (same place and style as admin-client.js,
         which they use via window globals; Chart.js and Leaflet stay classic SRI scripts above). -->
    <script is:inline type="module" src="/admin/analytics/main.js"></script>
  </body>
</html>
