      .foglio body.admin .ax-btn.primary { background: var(--foglio-accent); border-color: var(--foglio-accent); color: var(--foglio-paper); }
      .foglio body.admin .ax-btn.primary:hover:not(:disabled) { color: var(--foglio-paper); opacity: 0.9; }
      .foglio body.admin .ax-btn.danger:hover:not(:disabled) { border-color: var(--ax-neg); color: var(--ax-neg); }
      .foglio body.admin .ax-card-list { margin: 0; padding: 0; list-style: none; }
      .foglio body.admin .ax-card-list > li {
        padding: 0.8rem 0.25rem;
        border-bottom: 1px solid var(--ax-page-rule);
        font-family: var(--foglio-mono);
        font-size: 12px;
        color: var(--ax-page-ink);
      }
      .foglio body.admin .ax-card-list > li:last-child { border-bottom: none; }
      .foglio body.admin .ax-row { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; align-items: center; justify-content: space-between; }
      .foglio body.admin .ax-row .ax-grow { flex: 1 1 14rem; min-width: 0; overflow-wrap: anywhere; }
      .foglio body.admin .ax-sub { display: block; margin-top: 0.2rem; font-size: 10.5px; color: var(--ax-page-ink-mute); text-transform: uppercase; letter-spacing: 0.06em; }
      .foglio body.admin .ax-rule-off { opacity: 0.5; }
      .foglio body.admin .ax-kind {
        font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.08em;
        border: 1px solid var(--foglio-info); color: var(--foglio-info);
        background: var(--foglio-paper); border-radius: var(--foglio-radius-sm); padding: 1px 5px; margin-right: 0.4rem;
      }
      .foglio body.admin .ax-rule-form {
        display: grid; gap: 0.6rem; margin-top: 0.7rem; padding: 0.8rem;
        background: var(--ax-page-bg); border: 1px dashed var(--ax-page-rule); border-radius: var(--foglio-radius-sm);
      }
      .foglio body.admin .ax-rule-form .ax-fields { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .foglio body.admin .ax-rule-form select,
      .foglio body.admin .ax-rule-form input[type="text"] {
        font-family: var(--foglio-mono); font-size: 12px; padding: 0.45rem 0.6rem;
        background: var(--ax-page-bg-2); color: var(--ax-page-ink);
        border: 1px solid var(--ax-page-rule); border-radius: var(--foglio-radius-sm); min-width: 0;
      }
      .foglio body.admin .ax-rule-form input[name="value"] { flex: 1 1 14rem; }
      .foglio body.admin .ax-rule-form input[name="note"] { flex: 1 1 10rem; }
      .foglio body.admin .ax-preview { font-size: 11.5px; color: var(--ax-page-ink-soft); }
      .foglio body.admin .ax-preview-warn {
        padding: 0.5rem 0.7rem; background: var(--foglio-paper); color: var(--foglio-warn);
        border: 1px solid var(--foglio-warn); border-radius: var(--foglio-radius-sm); font-weight: 600;
      }
      .foglio body.admin .ax-legacy-note { font-family: var(--foglio-mono); font-size: 10.5px; color: var(--ax-page-ink-mute); margin: 0 0 0.6rem; }
      @media (pointer: coarse) {
        .foglio body.admin .ax-btn,
        .foglio body.admin .ax-bulk-flag,
        .foglio body.admin .ax-flag-btn,
        .foglio body.admin .ax-recent .ax-bot,
        .foglio body.admin .ax-rule-form select,
        .foglio body.admin .ax-rule-form input[type="text"] { min-height: 44px; min-width: 44px; }
        .foglio body.admin .ax-qual-note label { min-height: 44px; }
      }
      .foglio body.admin .ax-rollup-btn { min-height: 44px; min-width: 44px; color: var(--ax-page-ink-soft); border-color: currentColor; }

      /* Phase 5: global filters, CSV export, Web Vitals */
      .foglio body.admin .ax-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.9rem; margin-top: 0.8rem; font-family: var(--foglio-mono); font-size: 11px; color: var(--ax-page-ink-soft); }
      .foglio body.admin .ax-filters label { display: inline-flex; align-items: center; gap: 0.4rem; text-transform: uppercase; letter-spacing: 0.1em; }
      .foglio body.admin .ax-filters select {
        font-family: var(--foglio-mono); font-size: 12px; min-height: 44px; padding: 0.4rem 0.6rem;
        background: var(--ax-page-bg-2); color: var(--ax-page-ink);
        border: 1px solid var(--ax-page-rule); border-radius: var(--foglio-radius-sm);
      }
      .foglio body.admin .ax-filter-note {
        margin: 0.7rem 0 0; padding: 0.5rem 0.7rem; font-family: var(--foglio-mono); font-size: 11px;
        background: var(--foglio-paper); color: var(--foglio-warn); border: 1px solid var(--foglio-warn); border-radius: var(--foglio-radius-sm);
      }
      .foglio body.admin .ax-export {
        display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; padding: 0 0.4rem;
        color: var(--foglio-accent-soft); text-decoration: underline; text-underline-offset: 3px;
      }
      .foglio body.admin .ax-section-head .ax-section-meta { display: inline-flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; justify-content: flex-end; }
      .foglio body.admin .ax-vitals { grid-template-columns: 1fr; margin-bottom: 1rem; }
      .foglio body.admin .ax-vital .ax-stat-value { font-size: 2rem; }
      .foglio body.admin .ax-vital.good .ax-stat-value { color: var(--foglio-pos); }
      .foglio body.admin .ax-vital.ni .ax-stat-value { color: var(--foglio-warn); }
      .foglio body.admin .ax-vital.poor .ax-stat-value { color: var(--foglio-neg); }
      .foglio body.admin .ax-vital-state { font-family: var(--foglio-mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; margin: 0 0 0.5rem; color: var(--foglio-ink-soft); }
      .foglio body.admin .ax-vital-split { display: flex; height: 6px; border-radius: 3px; overflow: hidden; background: var(--foglio-rule); margin: 0.4rem 0; }
      .foglio body.admin .ax-vital-split span { display: block; height: 100%; }
      .foglio body.admin .ax-vital-split .g { background: var(--foglio-pos); }
      .foglio body.admin .ax-vital-split .n { background: var(--foglio-warn); }
      .foglio body.admin .ax-vital-split .p { background: var(--foglio-neg); }
      .foglio body.admin .ax-vital-meta { font-family: var(--foglio-mono); font-size: 10.5px; color: var(--foglio-ink-soft); margin: 0.15rem 0; overflow-wrap: anywhere; }
      .foglio body.admin .ax-vital-dev b { font-weight: 600; }
      .foglio body.admin .ax-vital-dev .good, .foglio body.admin .ax-vital-dev b.good { color: var(--foglio-pos); }
      .foglio body.admin .ax-vital-dev b.ni { color: var(--foglio-warn); }
      .foglio body.admin .ax-vital-dev b.poor { color: var(--foglio-neg); }
      @media (min-width: 768px) { .foglio body.admin .ax-stats.ax-vitals { grid-template-columns: repeat(3, 1fr); } }

      /* Tablet */
      @media (min-width: 768px) {
        .foglio body.admin .ax-wrap { padding: 1.75rem 1.75rem 4rem; }
        .foglio body.admin .ax-head h1 { font-size: var(--foglio-fs-4xl); }
        .foglio body.admin .ax-stats { grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
        .foglio body.admin .ax-stat-value { font-size: 2.2rem; }
        .foglio body.admin .ax-grid-2 { grid-template-columns: 1fr 1fr; gap: 2rem; }
        .foglio body.admin .ax-grid-3 { grid-template-columns: 1fr 1fr; gap: 2rem; }
        .foglio body.admin #world-map { height: 360px; }
        .foglio body.admin .ax-chart-wrap canvas { height: 280px !important; }

        .foglio body.admin .ax-list li {
          grid-template-columns: 1fr auto 80px;
          padding: 0.7rem 0.25rem;
        }
        .foglio body.admin .ax-list .ax-bar {
          display: block;
          width: 80px;
          height: 2px;
          background: var(--ax-page-rule);
          overflow: hidden;
          align-self: center;
        }
        .foglio body.admin .ax-list .ax-bar-fill { display: block; height: 100%; background: var(--foglio-accent); }
        .foglio body.admin .ax-engaged li { grid-template-columns: 1fr auto; }
        .foglio body.admin .ax-recent li { grid-template-columns: auto 1fr auto auto; }
      }

      /* Desktop */
      @media (min-width: 1024px) {
        .foglio body.admin .ax-wrap { padding: 2rem 2.5rem 5rem; max-width: 1400px; }
        .foglio body.admin .ax-head h1 { font-size: var(--foglio-fs-5xl); }
        .foglio body.admin .ax-stats { grid-template-columns: repeat(6, 1fr); }
        .foglio body.admin .ax-stats.ax-stats-4 { grid-template-columns: repeat(4, 1fr); }
        .foglio body.admin .ax-grid-3 { grid-template-columns: 1fr 1fr 1fr; gap: 2.5rem; }
        .foglio body.admin #world-map { height: 420px; }
        .foglio body.admin .ax-chart-wrap canvas { height: 320px !important; }
      }
    </style>
  </head>
  <body class="admin">
    <AdminNav currentPage="analytics" />

    <div class="ax-wrap">
      <header class="ax-head">
        <p class="ax-eyebrow">
          <span>Admin · Analytics</span>
          <span class="ax-live"><span class="ax-live-dot"></span><span id="live-count">—</span> ora</span>
        </p>
        <h1><em class="acc">Analytics.</em></h1>

        <div class="ax-controls">
          <div class="ax-periods" id="ax-periods">
            <button data-period="today">Oggi</button>
            <button data-period="7d">7g</button>
            <button data-period="30d">30g</button>
            <button data-period="90d">90g</button>
            <button data-period="12m">12m</button>
          </div>
          <div class="ax-navstrip">
            <button id="nav-prev" title="Periodo precedente">‹</button>
            <span class="ax-cal-label" id="cal-label" title="Clicca per range custom">—</span>
            <button id="nav-next" title="Periodo successivo">›</button>
          </div>
          <div class="ax-daterange" id="date-range">
            <input type="date" id="date-from" />
            <span>—</span>
            <input type="date" id="date-to" />
            <button id="date-go">Vai</button>
          </div>
        </div>
        <div class="ax-filters" role="group" aria-label="Filtri globali">
          <label>Paese <select id="f-country"><option value="">Tutti</option></select></label>
          <label>Device
            <select id="f-device">
              <option value="">Tutti</option><option value="mobile">mobile</option>
              <option value="tablet">tablet</option><option value="desktop">desktop</option>
            </select>
          </label>
          <label>Canale
            <select id="f-channel">
              <option value="">Tutti</option><option value="direct">direct</option><option value="search">search</option>
              <option value="social">social</option><option value="ai">ai</option><option value="email">email</option>
              <option value="referral">referral</option><option value="campaign">campaign</option>
            </select>
          </label>
          <button type="button" class="ax-btn" id="f-reset" hidden>Azzera filtri</button>
        </div>
        <p class="ax-filter-note" id="filter-note" role="status" hidden></p>
      </header>

      <section class="ax-stats" id="summary">
        <div class="ax-stat">
          <div class="ax-stat-label">Pageviews <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value acc" id="s-pageviews">—</div>
          <div class="ax-stat-delta" id="s-pageviews-delta"></div>
          <div class="ax-stat-tooltip">Pagine totali viste nel periodo. Include visite ripetute.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Visitatori <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="s-visitors">—</div>
          <div class="ax-stat-delta" id="s-visitors-delta"></div>
          <div class="ax-stat-tooltip">Visitatori unici giornalieri (hash anonimo IP+UA+data). Nessun cookie.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Tempo medio <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="s-time">—</div>
          <div class="ax-stat-tooltip">Tempo sulla pagina misurato fino all'uscita o cambio tab. Max 60 min.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Scroll <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="s-scroll">—</div>
          <div class="ax-stat-tooltip">Percentuale media di scroll. 100% = fondo pagina.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Bounce <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="s-bounce">—</div>
          <div class="ax-stat-tooltip">Visitatori con &lt;5s sulla pagina o nessuna interazione.</div>
        </div>
        <div class="ax-stat suspect">
          <div class="ax-stat-label">Sospetti <span class="ax-legacy-tag" title="Sistema vecchio: sostituito da verdetto e regole bot, verrà rimosso dopo il periodo di confronto">legacy</span> <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="s-suspects">—</div>
          <button class="ax-flag-btn" id="flag-suspects-btn" title="Legacy: flag per hash, sostituito dalle regole bot">Flag come bot (legacy)</button>
          <div class="ax-stat-tooltip">LEGACY. Visitatori con zero engagement (tempo ≤5s e scroll 0%), non ancora flaggati. Usa "Da rivedere" e le regole bot al suo posto.</div>
        </div>
      </section>

      <!-- Qualità traffico: umano / non verificato / bot -->
      <div class="ax-section-head">
        <h2>Qualità traffico</h2>
        <span class="ax-section-meta" id="qual-meta">visite uniche per verdetto</span>
      </div>
      <div class="ax-qual" id="quality">
        <div class="ax-stat human">
          <div class="ax-stat-label">Umani</div>
          <div class="ax-stat-value" id="q-human">—</div>
        </div>
        <div class="ax-stat unverified">
          <div class="ax-stat-label">Non verificati</div>
          <div class="ax-stat-value" id="q-unverified">—</div>
          <div class="ax-stat-delta" id="q-pct"></div>
        </div>
        <div class="ax-stat bot">
          <div class="ax-stat-label">Bot</div>
          <div class="ax-stat-value" id="q-bot">—</div>
        </div>
      </div>
      <p class="ax-qual-note">
        <label>
          <input type="checkbox" id="include-all" />
          Includi non verificati (numeri come prima)
        </label>
        <span id="q-mode">—</span>
        <span id="q-legacy"></span>
      </p>
      <p class="ax-qual-note" id="data-source-note">
        <span>Aggiornamento dati: <span id="data-source">—</span></span>
        <button type="button" class="ax-bulk-flag ax-rollup-btn" id="rollup-recalc" title="Ricalcola gli aggregati giornalieri del periodo (esclude oggi)">Ricalcola aggregati</button>
        <span id="rollup-status" role="status"></span>
      </p>

      <div class="ax-section-head">
        <h2>Da rivedere</h2>
        <span class="ax-section-meta">non verificati, raggruppati per profilo</span>
      </div>
      <div class="ax-recent-card">
        <ul class="ax-card-list" id="review-list"><li class="ax-loading">Caricamento…</li></ul>
      </div>

      <div class="ax-section-head">
        <h2>Regole bot</h2>
        <span class="ax-section-meta">valgono dalle nuove visite</span>
      </div>
      <div class="ax-recent-card">
        <ul class="ax-card-list" id="rules-list"><li class="ax-loading">Caricamento…</li></ul>
      </div>

      <!-- Visitatori recenti — featured: live feed -->
      <div class="ax-section-head ax-section-head--live">
        <h2>
          <span class="ax-live-dot" aria-hidden="true"></span>
          Visitatori recenti
        </h2>
        <div class="ax-bulk-actions">
          <span class="ax-legacy-tag" title="Sistema vecchio: sostituito da verdetto e regole bot, verrà rimosso dopo il periodo di confronto">legacy</span>
          <button class="ax-bulk-flag" id="flag-all-bots" title="Legacy: flag per hash">Flag zero-engagement (legacy)</button>
          <button class="ax-bulk-flag" id="unflag-recent" title="Legacy: rimuove dai bot gli hash flaggati nelle ultime 24 ore">Annulla flag fatti oggi (legacy)</button>
          <button class="ax-bulk-flag" id="unflag-all" title="Legacy: rimuove TUTTI gli hash dalla bot list (paracadute)">Annulla TUTTI (legacy)</button>
        </div>
      </div>
      <div class="ax-recent-card">
        <ul class="ax-recent" id="recent-list"><li class="ax-loading">Caricamento…</li></ul>
      </div>

      <div class="ax-section-head">
        <h2>Traffico nel tempo</h2>
        <span class="ax-section-meta" id="chart-meta">pageviews · visitatori <a class="ax-export" data-export="daily" href="#" download>Esporta CSV</a></span>
      </div>
      <div class="ax-chart-wrap"><canvas id="chart"></canvas></div>

      <div class="ax-section-head">
        <h2>Distribuzione geografica</h2>
        <span class="ax-section-meta" id="geo-meta">—</span>
      </div>
      <div class="ax-map-card">
        <div id="world-map"></div>
        <div class="ax-map-legend">
          <span>0</span>
          <div class="ax-map-legend-bar"></div>
          <span id="map-max-label">max</span>
        </div>
      </div>

      <div class="ax-section-head">
        <h2>Sezioni</h2>
        <span class="ax-section-meta">dove leggono <a class="ax-export" data-export="top_pages" href="#" download>Esporta CSV</a></span>
      </div>
      <div class="ax-grid-2">
        <div>
          <ul class="ax-list" id="sections-list"></ul>
        </div>
        <div>
          <ul class="ax-list" id="top-pages-list"></ul>
        </div>
      </div>

      <div class="ax-section-head">
        <h2>Post più letti</h2>
        <span class="ax-section-meta">engagement = tempo × scroll</span>
      </div>
      <ul class="ax-list ax-engaged" id="engaged-list"></ul>

      <div class="ax-section-head">
        <h2>Sessioni</h2>
        <span class="ax-section-meta">visite con pausa &lt; 30 min · senza cookie</span>
      </div>
      <p class="ax-unavailable" id="sess-unavailable" hidden>Sessioni non ancora attive: applica la migrazione Fase 2.</p>
      <section class="ax-stats ax-stats-4" id="sessions-stats">
        <div class="ax-stat">
          <div class="ax-stat-label">Sessioni <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value acc" id="se-count">—</div>
          <div class="ax-stat-delta" id="se-count-delta"></div>
          <div class="ax-stat-tooltip">Una sessione = stesso visitatore anonimo con pause &lt; 30 minuti. A mezzanotte UTC l'identificativo cambia: una visita a cavallo si divide in due.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Bounce reale <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="se-bounce">—</div>
          <div class="ax-stat-delta" id="se-bounce-delta"></div>
          <div class="ax-stat-tooltip">Sessioni con 1 sola pagina e meno di 10 s di tempo attivo. Il "Bounce" in alto e il vecchio calcolo per visitatore.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Pagine / sessione <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="se-pages">—</div>
          <div class="ax-stat-tooltip">Pageview medie per sessione.</div>
        </div>
        <div class="ax-stat">
          <div class="ax-stat-label">Tempo attivo medio <span class="ax-stat-info">?</span></div>
          <div class="ax-stat-value" id="se-time">—</div>
          <div class="ax-stat-tooltip">Somma del tempo visibile sulle pagine della sessione, in media.</div>
        </div>
      </section>

      <div class="ax-section-head">
        <h2>Ingresso e uscita</h2>
        <span class="ax-section-meta">prima e ultima pagina della sessione</span>
      </div>
      <div class="ax-grid-2">
        <ul class="ax-list" id="entry-list"></ul>
