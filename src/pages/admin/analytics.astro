    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.css" integrity="sha384-b8ANgTJvdlAnWM5YGMpKn7Kodm+1k7NYNG9zdjTCcZcKatzYHwZ0RLdWarbJJVzU" crossorigin="anonymous" />
    <script is:inline src="/admin/admin-client.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.min.js" integrity="sha384-u5N8qJeJOO2iqNjIKTdl6KeKsEikMAmCUBPc6sC6uGpgL34aPJ4VgNhuhumedpEk" crossorigin="anonymous"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" integrity="sha384-vsrfeLOOY6KuIYKDlmVH5UiBmgIdB1oEf7p01YgWHuqmOHfZr374+odEv96n9tNC" crossorigin="anonymous"></script>
    <script is:inline>
      var chartInstance = null;

      function cssVar(name, fallback) {
        var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
        return v || fallback;
      }
      var FOGLIO_ACCENT = cssVar("--foglio-accent", "#a8451a");
      var FOGLIO_ACCENT_SOFT = cssVar("--foglio-accent-soft", "#c8714a");
      var FOGLIO_PAPER = cssVar("--foglio-paper", "#fbf7ee");
      var FOGLIO_PAPER_2 = cssVar("--foglio-paper-2", "#f1ebdd");
      var FOGLIO_INK = cssVar("--foglio-ink", "#221a12");
      var FOGLIO_INK_SOFT = cssVar("--foglio-ink-soft", "#5e4d3a");
      var FOGLIO_RULE = cssVar("--foglio-rule", "#d8cebd");
      var CYAN = cssVar("--ax-cyan", "#00b4a6");
      function withAlpha(hex, a) {
        var m = /^#?([0-9a-f]{6})$/i.exec(hex);
        if (!m) return hex;
        var n = parseInt(m[1], 16);
        return "rgba(" + (n >> 16 & 255) + "," + (n >> 8 & 255) + "," + (n & 255) + "," + a + ")";
      }

      function fmt(n) { n = Number(n) || 0; return n >= 1000 ? (n / 1000).toFixed(1) + "k" : String(n); }
      function fmtTime(s) { s = Number(s) || 0; return s >= 60 ? Math.floor(s / 60) + "m " + (s % 60) + "s" : s + "s"; }

      var DAYS_SHORT = ["Dom", "Lun", "Mar", "Mer", "Gio", "Ven", "Sab"];
      var MONTHS_SHORT = ["Gen", "Feb", "Mar", "Apr", "Mag", "Giu", "Lug", "Ago", "Set", "Ott", "Nov", "Dic"];

      function fmtChartLabel(dateStr, groupBy) {
        if (groupBy === "hour") return dateStr.slice(11, 16);
        if (groupBy === "month") { var p = dateStr.split("-"); return MONTHS_SHORT[parseInt(p[1], 10) - 1] + " " + p[0].slice(2); }
        var d = new Date(dateStr + "T00:00:00");
        return DAYS_SHORT[d.getDay()] + " " + d.getDate() + " " + MONTHS_SHORT[d.getMonth()];
      }
      function fmtTooltipTitle(dateStr, groupBy) {
        if (groupBy === "hour") return dateStr;
        if (groupBy === "month") { var p = dateStr.split("-"); return MONTHS_SHORT[parseInt(p[1], 10) - 1] + " " + p[0]; }
        var d = new Date(dateStr + "T00:00:00");
        return DAYS_SHORT[d.getDay()] + " " + d.getDate() + " " + MONTHS_SHORT[d.getMonth()] + " " + d.getFullYear();
      }
      // UTC, to match src/lib/date-range.ts (isoDate)
      function dateStr(d) { return d.toISOString().slice(0, 10); }

      function fmtCalDate(iso) { var d = new Date(iso + "T00:00:00"); return d.getDate() + " " + MONTHS_SHORT[d.getMonth()]; }
      function fmtCalDateFull(iso) { var d = new Date(iso + "T00:00:00"); return d.getDate() + " " + MONTHS_SHORT[d.getMonth()] + " " + d.getFullYear(); }

      function setDelta(el, pct) {
        if (pct == null) { el.textContent = ""; el.className = "ax-stat-delta"; return; }
        var prefix = pct > 0 ? "▲ " : pct < 0 ? "▼ " : "= ";
        el.textContent = prefix + Math.abs(pct).toFixed(1) + "% vs periodo prec.";
        el.className = "ax-stat-delta " + (pct > 0 ? "up" : pct < 0 ? "down" : "");
      }

      function renderListRows(rows, keyField, valueField, isPath, ulId, emptyMsg) {
        var ul = document.getElementById(ulId);
        if (!ul) return;
        if (!rows || !rows.length) { ul.innerHTML = '<li class="ax-empty">' + escapeHtml(emptyMsg || "Nessun dato.") + '</li>'; return; }
        var max = Number(rows[0][valueField]) || 1;
        ul.innerHTML = rows.map(function(r) {
          var key = r[keyField] != null && r[keyField] !== "" ? r[keyField] : "(diretto)";
          var val = Number(r[valueField]) || 0;
          var pct = Math.round(val / max * 100);
          return '<li>' +
            '<span class="ax-key' + (isPath ? ' path' : '') + '" title="' + escapeHtml(key) + '">' + escapeHtml(key) + '</span>' +
            '<span class="ax-val">' + fmt(val) + '</span>' +
            '<span class="ax-bar"><span class="ax-bar-fill" style="width:' + pct + '%"></span></span>' +
            '</li>';
        }).join("");
      }

      function pctText(n) { return (Number(n) || 0).toFixed(1).replace(".", ",") + "%"; }

      function renderSessions(d) {
        var se = d.sessions || {};
        var off = !se.available;
        document.getElementById("sess-unavailable").hidden = !off;
        document.getElementById("se-count").textContent = off ? "—" : fmt(se.count);
        document.getElementById("se-bounce").textContent = off ? "—" : pctText(se.bounce_rate);
        document.getElementById("se-pages").textContent = off ? "—" : String(se.pages_per_session);
        document.getElementById("se-time").textContent = off ? "—" : fmtTime(se.avg_engaged_seconds);
        setDelta(document.getElementById("se-count-delta"), off ? null : se.count_delta_pct);
        var bd = document.getElementById("se-bounce-delta");
        if (off || se.bounce_rate_delta_pp == null) { bd.textContent = ""; bd.className = "ax-stat-delta"; }
        else {
          var pp = se.bounce_rate_delta_pp;
          bd.textContent = (pp > 0 ? "▲ " : pp < 0 ? "▼ " : "= ") + Math.abs(pp).toFixed(1) + " pp vs periodo prec.";
          // a higher bounce is worse
          bd.className = "ax-stat-delta " + (pp > 0 ? "down" : pp < 0 ? "up" : "");
        }
        renderListRows(d.entry_pages, "path", "sessions", true, "entry-list", "Nessuna sessione nel periodo.");
        renderListRows(d.exit_pages, "path", "sessions", true, "exit-list", "Nessuna sessione nel periodo.");
        renderListRows((se.by_channel || []), "channel", "sessions", false, "channels-list", "Nessuna sessione nel periodo.");
        var ev = (d.events || []).map(function(e) {
          return { label: e.name + (e.prop ? " · " + e.prop : ""), count: e.count };
        });
        renderListRows(ev, "label", "count", false, "events-list", "Nessun evento nel periodo.");
        renderGoals(d.goals || []);
      }

      function renderGoals(goals) {
        var grid = document.getElementById("goals-grid");
        if (!goals.length) { grid.innerHTML = '<p class="ax-empty">Nessun obiettivo.</p>'; return; }
        grid.innerHTML = goals.map(function(g) {
          var rows = (g.by_channel || []).map(function(c) {
            return '<li><span class="ax-key">' + escapeHtml(c.channel) + '</span>' +
              '<span class="ax-val" title="' + escapeHtml(c.conversions + " / " + c.sessions + " sessioni") + '">' + fmt(c.conversions) + ' · ' + pctText(c.rate) + '</span></li>';
          }).join("");
          var entries = (g.by_entry || []).slice(0, 3).map(function(c) {
            return escapeHtml(c.path) + " (" + fmt(c.conversions) + ")";
          }).join(" · ");
          return '<div class="ax-goal">' +
            '<div class="ax-goal-head"><span>' + escapeHtml(g.label) + '</span><span><b>' + fmt(g.conversions) + '</b> · ' + pctText(g.rate) + '</span></div>' +
            '<ul class="ax-list">' + (rows || '<li class="ax-empty">Nessuna conversione.</li>') + '</ul>' +
            (entries ? '<div class="ax-section-meta" title="Pagine di ingresso con più conversioni">Da: ' + entries + '</div>' : '') +
            '</div>';
        }).join("");
      }

      function renderEngaged(rows) {
        var ul = document.getElementById("engaged-list");
        if (!rows || !rows.length) { ul.innerHTML = '<li class="ax-empty">Nessun post con dati di engagement nel periodo.</li>'; return; }
        ul.innerHTML = rows.map(function(r) {
          var t = Number(r.avg_time) || 0;
          var s = Number(r.avg_scroll) || 0;
          var pv = Number(r.pageviews) || 0;
          return '<li>' +
            '<div class="ax-eng-main">' +
              '<span class="ax-eng-title" title="' + escapeHtml(r.pathname) + '">' + escapeHtml(r.pathname) + '</span>' +
              '<span class="ax-eng-meta"><b>' + fmtTime(t) + '</b> · scroll <b>' + s + '%</b></span>' +
            '</div>' +
            '<span class="ax-eng-pv">' + pv + ' pv</span>' +
            '</li>';
        }).join("");
      }

      var COUNTRY_FLAGS = {"IT":"🇮🇹","GB":"🇬🇧","FR":"🇫🇷","DE":"🇩🇪","ES":"🇪🇸","US":"🇺🇸","NL":"🇳🇱","BE":"🇧🇪","CH":"🇨🇭","AT":"🇦🇹","PT":"🇵🇹","PL":"🇵🇱","CZ":"🇨🇿","HU":"🇭🇺","RO":"🇷🇴","BG":"🇧🇬","GR":"🇬🇷","FI":"🇫🇮","SE":"🇸🇪","NO":"🇳🇴","DK":"🇩🇰","IE":"🇮🇪","UA":"🇺🇦","RU":"🇷🇺","TR":"🇹🇷","JP":"🇯🇵","KR":"🇰🇷","CN":"🇨🇳","IN":"🇮🇳","BR":"🇧🇷","CA":"🇨🇦","AU":"🇦🇺","MX":"🇲🇽","AR":"🇦🇷","EG":"🇪🇬","ZA":"🇿🇦","NZ":"🇳🇿","SG":"🇸🇬","AE":"🇦🇪","SA":"🇸🇦","IL":"🇮🇱"};
      function countryFlag(c) { return c && COUNTRY_FLAGS[c] ? COUNTRY_FLAGS[c] : "🌐"; }
      function deviceIcon(t) { return t === "mobile" ? "📱" : t === "tablet" ? "📋" : "💻"; }

      function timeAgo(dateStr) {
        var diff = Math.floor((new Date() - parseDbDate(dateStr)) / 1000);
        if (diff < 60) return "ora";
        if (diff < 3600) return Math.floor(diff / 60) + "m";
        if (diff < 86400) return Math.floor(diff / 3600) + "h";
        var d = Math.floor(diff / 86400);
        return d === 1 ? "ieri" : d + "g";
      }

      var _lastVisitors = [];
      var _suspectCountries = {};

      function flagAsBot(hash, btn) {
        var row = btn.closest("li");
        btn.disabled = true;
        fetch("/api/admin/bot", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ hash: hash }) })
          .then(function(r) {
            btn.disabled = false;
            if (!r.ok) return;
            row.classList.add("flagged");
            btn.textContent = "↺";
            btn.title = "Annulla flag bot";
            btn.onclick = function() { unflagAsBot(hash, btn); };
          });
      }
      function unflagAsBot(hash, btn) {
        var row = btn.closest("li");
        btn.disabled = true;
        fetch("/api/admin/bot", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ hash: hash }) })
          .then(function(r) {
            btn.disabled = false;
            if (!r.ok) return;
            row.classList.remove("flagged");
            btn.textContent = "🤖";
            btn.title = "Flag come bot (legacy: flag per hash, sostituito dalle regole bot)";
            btn.onclick = function() { flagAsBot(hash, btn); };
          });
      }
      window.flagAsBot = flagAsBot;
      window.unflagAsBot = unflagAsBot;

      function flagAllBots() {
        var hashes = [];
        _lastVisitors.forEach(function(v) {
          if (!v.visitor_hash) return;
          var noTime = v.time_on_page == null || Number(v.time_on_page) <= 5;
          var noScroll = v.scroll_depth == null || Number(v.scroll_depth) === 0;
          if (noTime && noScroll) hashes.push(v.visitor_hash);
        });
        if (!hashes.length) return;
        var btn = document.getElementById("flag-all-bots");
        btn.disabled = true; btn.textContent = "Flagging…";
        fetch("/api/admin/bot", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ hashes: hashes }) })
          .then(function(r) { if (!r.ok) throw new Error("HTTP " + r.status); return r.json(); })
          .then(function(d) { btn.textContent = d.flagged + " flaggati"; })
          .catch(function(e) { console.error("flagAllBots failed", e); btn.disabled = false; btn.textContent = "Errore"; });
      }

      function renderRecentVisitors(visitors) {
        _lastVisitors = visitors || [];
        var zero = _lastVisitors.filter(function(v) {
          if (!v.visitor_hash) return false;
          var noTime = v.time_on_page == null || Number(v.time_on_page) <= 5;
          var noScroll = v.scroll_depth == null || Number(v.scroll_depth) === 0;
          return noTime && noScroll;
        }).length;
        var bulk = document.getElementById("flag-all-bots");
        bulk.style.display = zero > 0 ? "inline-block" : "none";
        bulk.disabled = false;
        bulk.textContent = "Flag zero-engagement (" + zero + ") (legacy)";

        var ul = document.getElementById("recent-list");
        if (!visitors || !visitors.length) { ul.innerHTML = '<li class="ax-loading">Nessun visitatore recente.</li>'; return; }

        ul.innerHTML = visitors.map(function(v) {
          var flag = countryFlag(v.country);
          var page = escapeHtml(v.pathname || "/");
          var device = deviceIcon(v.device_type);
          var browser = escapeHtml(v.browser || "?");
          var os = escapeHtml(v.os || "?");
          var ref = v.referrer ? escapeHtml(v.referrer) : "";
          var time = v.time_on_page != null ? fmtTime(Number(v.time_on_page)) : "";
          var scroll = v.scroll_depth != null ? Number(v.scroll_depth) + "%" : "";
          var ago = timeAgo(v.created_at);
          var hash = v.visitor_hash || "";

          var metaParts = [device + " " + browser + " / " + os];
          if (ref) metaParts.push("da " + ref);
          if (time) metaParts.push("⏱ " + time);
          if (scroll) metaParts.push("↓ " + scroll);

          if (v.verdict === "unverified") metaParts.push("non verificato");
          else if (v.verdict === "bot") metaParts.push("bot");
          var botBtn = hash ? '<button class="ax-bot" data-hash="' + escapeHtml(hash) + '" title="Flag come bot (legacy: flag per hash, sostituito dalle regole bot)">🤖</button>' : '';
          var noTime = v.time_on_page == null || Number(v.time_on_page) <= 5;
          var noScroll = v.scroll_depth == null || Number(v.scroll_depth) === 0;
          var suspect = (noTime && noScroll && hash) ? ' suspect' : '';

          return '<li class="' + suspect.trim() + '">' +
            '<span class="ax-flag">' + flag + '</span>' +
            '<span class="ax-path"><span>' + page + '</span><span class="ax-meta">' + metaParts.join(" · ") + '</span></span>' +
            '<span class="ax-time">' + ago + '</span>' +
            botBtn +
            '</li>';
        }).join("");
        ul.querySelectorAll("button.ax-bot").forEach(function(b) {
          b.onclick = function() { flagAsBot(b.dataset.hash, b); };
        });
      }

      /* Bot detection: quality card, review list, rules */
      var includeAll = false;
      var _review = [];
      var filters = { country: "", device: "", channel: "" };
      function filterQuery() {
        return ["country", "device", "channel"].filter(function(k) { return filters[k]; })
          .map(function(k) { return "&" + k + "=" + encodeURIComponent(filters[k]); }).join("");
      }
      function statsUrl(period) { return "/api/stats?period=" + period + (includeAll ? "&include=all" : "") + filterQuery(); }
      function reloadStats() { loadData(currentPeriod + (currentFrom && currentTo ? "&from=" + currentFrom + "&to=" + currentTo : "")); }

      function renderQuality(d) {
        var q = d.quality || { human: 0, unverified: 0, bot: 0, unverified_pct: 0 };
        document.getElementById("q-human").textContent = fmt(q.human);
        document.getElementById("q-unverified").textContent = fmt(q.unverified);
        document.getElementById("q-bot").textContent = fmt(q.bot);
        document.getElementById("q-pct").textContent = q.unverified_pct + "% dei non-bot";
        document.getElementById("q-mode").textContent = d.mode === "all"
          ? "Numeri principali: tutte le visite non flaggate (come prima)"
          : "Numeri principali: solo visite umane";
        var sl = d.summary_legacy;
        document.getElementById("q-legacy").textContent = sl
          ? "Numeri vecchi: " + fmt(sl.pageviews) + " pageviews · " + fmt(sl.visitors) + " visitatori"
          : "";
      }

      /* Daily rollups: where the numbers come from + manual recompute (cookie session, no tokens). */
      var _period = null;
      function renderDataSource(d) {
        _period = d.period || null;
        var src = d.source || { rollup_days: 0, raw_days: 0 };
        document.getElementById("data-source").textContent =
          src.rollup_days + " giorni da aggregati, " + src.raw_days + " dal vivo";
      }
      function recalcRollups() {
        if (!_period) return;
        var btn = document.getElementById("rollup-recalc");
        var status = document.getElementById("rollup-status");
        var yesterday = new Date(Date.now() - 86400000).toISOString().slice(0, 10);
        var to = _period.to < yesterday ? _period.to : yesterday;
        var from = _period.from;
        var maxFrom = new Date(new Date(to + "T00:00:00Z").getTime() - 399 * 86400000).toISOString().slice(0, 10);
        if (from < maxFrom) from = maxFrom;
        if (from > to) { status.textContent = "Nessun giorno chiuso nel periodo"; return; }
        btn.disabled = true;
        status.textContent = "Ricalcolo " + from + " → " + to + "…";
        apiFetch("/api/admin/analytics-rollup", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ from: from, to: to }),
        })
          .then(function(r) { return r.json(); })
          .then(function(j) { status.textContent = "Ricalcolati " + j.days + " giorni"; reloadStats(); })
          .catch(function(e) { status.textContent = "Errore: " + e.message; })
          .then(function() { btn.disabled = false; });
      }
      document.getElementById("rollup-recalc").addEventListener("click", recalcRollups);

      function ruleKindLabel(k) {
        return { ua_contains: "user-agent contiene", referrer_host: "referrer", path_prefix: "percorso inizia con", hash_today: "visitatore (oggi)" }[k] || k;
      }

      function suggestRule(row) {
        if (row.referrer) return { kind: "referrer_host", value: row.referrer };
        var p = String(row.path_pattern || "");
        if (p.length > 1 && p.charAt(p.length - 1) === "*") p = p.slice(0, -1);
        if (p.length > 1) return { kind: "path_prefix", value: p };
        return { kind: "ua_contains", value: "" };
      }

      function renderReview(rows) {
        _review = rows || [];
        var ul = document.getElementById("review-list");
        if (!_review.length) { ul.innerHTML = '<li class="ax-loading">Niente da rivedere nel periodo.</li>'; return; }
        ul.innerHTML = _review.map(function(r, i) {
          var parts = [deviceIcon(r.device_type) + " " + escapeHtml(r.browser || "?") + " / " + escapeHtml(r.os || "?")];
          if (r.referrer) parts.push("da " + escapeHtml(r.referrer));
          if (Number(r.max_score) > 0) parts.push("score " + Number(r.max_score));
          return '<li data-i="' + i + '"><div class="ax-row">' +
            '<span class="ax-grow">' + countryFlag(r.country) + " " + escapeHtml(r.path_pattern || "/") +
            '<span class="ax-sub">' + parts.join(" · ") + '</span></span>' +
            '<span>' + fmt(r.pageviews) + ' pv · ' + fmt(r.visits) + ' visite</span>' +
            '<button class="ax-btn" data-act="rule">Crea regola</button>' +
            '</div></li>';
        }).join("");
      }

      function openRuleForm(li) {
        var existing = li.querySelector(".ax-rule-form");
        if (existing) { existing.remove(); return; }
        var s = suggestRule(_review[Number(li.dataset.i)]);
        var form = document.createElement("div");
        form.className = "ax-rule-form";
        form.innerHTML =
          '<div class="ax-fields">' +
            '<select name="kind" aria-label="Tipo regola">' +
              ["ua_contains", "referrer_host", "path_prefix"].map(function(k) {
                return '<option value="' + k + '"' + (k === s.kind ? " selected" : "") + ">" + escapeHtml(ruleKindLabel(k)) + "</option>";
              }).join("") +
            '</select>' +
            '<input type="text" name="value" maxlength="200" aria-label="Valore" placeholder="es. HeadlessChrome" value="' + escapeHtml(s.value) + '" />' +
            '<input type="text" name="note" maxlength="300" aria-label="Nota" placeholder="nota (facoltativa)" />' +
          '</div>' +
          '<div class="ax-preview" data-role="preview">Scrivi un valore per vedere l\'anteprima.</div>' +
          '<div class="ax-fields">' +
            '<button class="ax-btn primary" data-act="save" disabled>Salva regola</button>' +
            '<button class="ax-btn" data-act="cancel">Annulla</button>' +
          '</div>';
        li.appendChild(form);
        var timer = null;
        var kindEl = form.querySelector('[name="kind"]'), valueEl = form.querySelector('[name="value"]');
        function schedule() {
          form.querySelector('[data-act="save"]').disabled = true;
          clearTimeout(timer);
          timer = setTimeout(function() { previewRule(form); }, 350);
        }
        kindEl.addEventListener("change", schedule);
        valueEl.addEventListener("input", schedule);
        valueEl.focus();
        if (valueEl.value) previewRule(form);
      }

      function previewRule(form) {
        var kind = form.querySelector('[name="kind"]').value;
        var value = form.querySelector('[name="value"]').value.trim();
        var box = form.querySelector('[data-role="preview"]');
        var save = form.querySelector('[data-act="save"]');
        form._ready = false;
        if (!value) { box.textContent = "Scrivi un valore per vedere l'anteprima."; return; }
        box.textContent = "Calcolo anteprima…";
        apiJson("/api/admin/bot-rules/preview", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ kind: kind, value: value }) })
          .then(function(p) {
            form._ready = true; save.disabled = false;
            if (!p.supported) {
              form._risky = true;
              box.innerHTML = '<div class="ax-preview-warn">Anteprima non disponibile per user-agent (non viene salvato). La regola colpirà ogni nuovo visitatore il cui user-agent contiene questo testo: usa una stringa specifica.</div>';
              return;
            }
            form._risky = Number(p.human) > 0;
            var msg = "Negli ultimi " + p.days + " giorni escluderebbe " + fmt(p.excluded) + " pageviews, di cui " + fmt(p.human) + " con segnale umano.";
            box.innerHTML = Number(p.human) > 0
              ? '<div class="ax-preview-warn">Attenzione: ' + escapeHtml(msg) + ' Potresti escludere lettori veri.</div>'
              : escapeHtml(msg);
          })
          .catch(function(e) { box.textContent = "Errore: " + e.message; });
      }

      function saveRule(form, btn) {
        if (!form._ready) return;
        if (form._risky && !confirm("Questa regola potrebbe colpire visite umane (o non è verificabile). Salvarla comunque?")) return;
        btn.disabled = true;
        var body = {
          kind: form.querySelector('[name="kind"]').value,
          value: form.querySelector('[name="value"]').value.trim(),
          note: form.querySelector('[name="note"]').value.trim() || undefined
        };
        apiJson("/api/admin/bot-rules", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) })
          .then(function() {
            form.innerHTML = '<div class="ax-preview">Regola salvata. Vale per le nuove visite; quelle già registrate restano come sono.</div>';
            loadRules();
          })
          .catch(function(e) { btn.disabled = false; form.querySelector('[data-role="preview"]').textContent = "Errore: " + e.message; });
      }

      document.getElementById("review-list").addEventListener("click", function(ev) {
