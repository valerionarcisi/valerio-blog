---
import "./AdminNav.css";

type PageId =
  | "home"
  | "analytics"
  | "comments"
  | "radar"
  | "meal-plan"
  | "body-comp"
  | "training"
  | "roma-arte-di-narrare";

interface Props {
  token: string;
  currentPage: PageId;
}

const { currentPage, token } = Astro.props;

const href = (slug: string) => `/admin/${slug}?token=${encodeURIComponent(token)}`;

// Eventi: aggiungere o rimuovere voci qui.
const events = [
  { id: "roma-arte-di-narrare" as const, label: "Roma · 18 Ott", href: href("arte-di-narrare") },
];

const groups: { title: string; links: { id: PageId; label: string; href: string }[] }[] = [
  { title: "Oggi", links: [{ id: "home", label: "Home", href: `/admin?token=${encodeURIComponent(token)}` }] },
  {
    title: "Sito",
    links: [
      { id: "analytics", label: "Analytics", href: href("analytics") },
      { id: "comments", label: "Commenti", href: href("comments") },
      { id: "radar", label: "Radar", href: href("radar") },
    ],
  },
  {
    title: "Dieta",
    links: [
      { id: "meal-plan", label: "Piano & spesa", href: href("meal-plan") },
      { id: "body-comp", label: "Body Comp", href: href("body-comp") },
    ],
  },
  {
    title: "Sport",
    links: [
      { id: "training", label: "Training", href: href("training") },
    ],
  },
  ...(events.length ? [{ title: "Eventi", links: events }] : []),
];

const currentLabel =
  groups.flatMap((g) => g.links).find((l) => l.id === currentPage)?.label ?? "Admin";
---

<!-- Top bar + hamburger (mobile only) -->
<div class="admin-topbar" aria-hidden="true"><span class="admin-topbar-title">{currentLabel}</span></div>
<button
  class="admin-hamburger"
  id="admin-hamburger"
  type="button"
  aria-label="Menu"
  aria-expanded="false"
  aria-controls="admin-sidebar"
>
  <span></span>
  <span></span>
  <span></span>
</button>

<!-- Backdrop -->
<div class="admin-backdrop" id="admin-backdrop"></div>

<nav class="admin-sidebar" id="admin-sidebar" aria-label="Admin">
  {groups.map((group) => (
    <div class="sidebar-section">
      <div class="sidebar-group-title">{group.title}</div>
      {group.links.map((link) => (
        <a
          href={link.href}
          class:list={["sidebar-link", { active: currentPage === link.id }]}
          aria-current={currentPage === link.id ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </div>
  ))}
</nav>

<script>
  const btn = document.getElementById('admin-hamburger');
  const sidebar = document.getElementById('admin-sidebar');
  const backdrop = document.getElementById('admin-backdrop');

  function openMenu() {
    sidebar?.classList.add('open');
    btn?.classList.add('open');
    btn?.setAttribute('aria-expanded', 'true');
    backdrop?.classList.add('visible');
    document.body.style.overflow = 'hidden';
    sidebar?.querySelector<HTMLElement>('.sidebar-link.active, .sidebar-link')?.focus();
  }
  function closeMenu(returnFocus = false) {
    sidebar?.classList.remove('open');
    btn?.classList.remove('open');
    btn?.setAttribute('aria-expanded', 'false');
    backdrop?.classList.remove('visible');
    document.body.style.overflow = '';
    if (returnFocus) btn?.focus();
  }

  btn?.addEventListener('click', () => {
    sidebar?.classList.contains('open') ? closeMenu(true) : openMenu();
  });
  backdrop?.addEventListener('click', () => closeMenu());

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sidebar?.classList.contains('open')) closeMenu(true);
  });

  // Close on link tap (mobile navigation)
  sidebar?.querySelectorAll('.sidebar-link').forEach(link => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 768) closeMenu();
    });
  });

  // Leaving mobile layout with the menu open: reset state
  window.matchMedia('(min-width: 769px)').addEventListener('change', (e) => {
    if (e.matches) closeMenu();
  });
</script>
