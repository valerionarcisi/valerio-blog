---
import "normalize.css";
import "~/styles/fonts.css";
import "~/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  cover?: string;
  lang?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = "/img/avatar.png", cover, lang } = Astro.props;

const currentLang = lang || (Astro.url.pathname.startsWith("/en") ? "en" : "it");
const pathname = Astro.url.pathname;
const itPath = currentLang === "en" ? pathname.replace(/^\/en/, "") || "/" : pathname;
const enPath = currentLang === "it" ? `/en${pathname}` : pathname;
const itUrl = new URL(itPath, Astro.site);
const enUrl = new URL(enPath, Astro.site);

// Optimize meta description (150-160 characters for best SEO)
const optimizedDescription = description.length > 160 
  ? description.substring(0, 157) + "..." 
  : description;

// Use cover image if available, otherwise default image
const socialImage = cover || image;
const fullImageUrl = new URL(socialImage, Astro.url);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Fonts are loaded via @fontsource packages -->
<link
  rel="apple-touch-icon"
  sizes="180x180"
  href="/favicon_io/apple-touch-icon.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href="/favicon_io/favicon-32x32.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="16x16"
  href="/favicon_io/favicon-16x16.png"
/>
<link rel="manifest" href="/favicon_io/site.webmanifest" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link
  rel="icon"
  type="image/png"
  sizes="192x192"
  href="/favicon_io/android-chrome-192x192.png"
/>
<link
  rel="icon"
  type="image/png"
  sizes="512x512"
  href="/favicon_io/android-chrome-512x512.png"
/>
<meta name="theme-color" content="#0a0a0c" />
<meta name="generator" content={Astro.generator} />
<!-- Dark theme only - apply immediately -->
<script is:inline>
  (function() {
    document.addEventListener('DOMContentLoaded', function() {
      document.body.setAttribute('data-theme', 'dark');
    });
  })();
</script>

<!-- Privacy-first self-hosted analytics — no cookies, no IP stored. localStorage holds only the opt-out flag `notrack`. -->
<script is:inline>
(function(){
  var EP="/api/e",ls=null;
  try{ls=window.localStorage;}catch(e){}
  function flag(){try{ls&&ls.setItem("notrack","1");}catch(e){}}
  if(new URLSearchParams(location.search).has("notrack")){flag();return;}
  if(location.pathname.indexOf("/admin")===0){flag();return;}
  try{if((ls&&ls.getItem("notrack"))||navigator.webdriver)return;}catch(e){if(navigator.webdriver)return;}
  function send(d){return fetch(EP,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(d),keepalive:true});}
  function rid(){
    var s="",i,a;
    try{a=new Uint8Array(12);crypto.getRandomValues(a);for(i=0;i<a.length;i++)s+=("0"+a[i].toString(16)).slice(-2);}
    catch(e){for(i=0;i<24;i++)s+=Math.floor(Math.random()*16).toString(16);}
    return s;
  }
  var id=rid();
  var ref=document.referrer;
  var params=new URLSearchParams(location.search);
  var utm={s:params.get("utm_source"),m:params.get("utm_medium"),c:params.get("utm_campaign"),t:params.get("utm_content")};
  if(utm.s||utm.m||utm.c||utm.t){
    params.delete("utm_source");params.delete("utm_medium");params.delete("utm_campaign");params.delete("utm_content");
    var qs=params.toString();
    history.replaceState(null,"",location.pathname+(qs?"?"+qs:"")+location.hash);
  }
  var data={type:"pageview",page_id:id,hostname:location.hostname,pathname:location.pathname,referrer:ref||null,
    utm_source:utm.s,utm_medium:utm.m,utm_campaign:utm.c,utm_content:utm.t,
    screen_width:screen.width,screen_height:screen.height,viewport_width:innerWidth,viewport_height:innerHeight,
    language:navigator.language,timezone:Intl.DateTimeFormat().resolvedOptions().timeZone};
  var pv=send(data).catch(function(){});
  // events wait for the pageview; window.va is undefined when tracking is off
  window.va={track:function(n,p){pv.then(function(){return send({type:"event",page_id:id,hostname:location.hostname,pathname:location.pathname,name:n,prop:p==null?null:String(p)});}).catch(function(){});}};
  var blog=/^(\/en)?\/blog\//.test(location.pathname),s75,s100,cc;
  document.addEventListener("click",function(e){
    var a=e.target.closest&&e.target.closest("a[href]"),u,m;if(!a)return;
    try{u=new URL(a.href,location.href);}catch(x){return;}
    if(a.dataset.share){va.track("share",a.dataset.share);return;}
    if(u.protocol!=="http:"&&u.protocol!=="https:")return;
    if(m=/\.(pdf|zip|epub|mp3|mp4|docx|xlsx)$/i.exec(u.pathname))va.track("download",m[1].toLowerCase());
    else if(u.hostname!==location.hostname)va.track("outbound_click",u.hostname);
  },true);
  document.addEventListener("copy",function(){
    var n=getSelection().anchorNode;n=n&&(n.closest?n:n.parentElement);
    if(!cc&&n&&n.closest("pre,code")){cc=1;va.track("copy_code");}
  });
  var visible=document.visibilityState==="visible",last=Date.now(),acc=0,maxScroll=0,lastSent="";
  function tick(){if(visible){var n=Date.now();acc+=n-last;last=n;}}
  function onScroll(){var h=document.documentElement.scrollHeight-innerHeight;if(h>0){var pct=Math.round(scrollY/h*100/5)*5;if(pct>maxScroll)maxScroll=pct;if(blog){if(pct>=75&&!s75){s75=1;va.track("scroll_75");}if(pct>=100&&!s100){s100=1;va.track("scroll_100");}}}}
  window.addEventListener("scroll",onScroll,{passive:true});
  var eng=0;
  function engage(){
    if(eng)return;eng=1;
    ["scroll","pointerdown","keydown","touchstart"].forEach(function(t){removeEventListener(t,engage);});
    send({type:"engage",page_id:id,hostname:location.hostname}).catch(function(){});
  }
  // only a real interaction vouches for a human: headless crawlers and link previewers sit "visible" for seconds too
  ["scroll","pointerdown","keydown","touchstart"].forEach(function(t){addEventListener(t,engage,{passive:true});});
  // Web Vitals (no library): last LCP, CLS = worst 5 s session window, INP = p98 of interactions. Absent if unsupported.
  var lcp,cls,inp,sv=0,sf=0,sl=0,im={},st;
  function ob(t,f,o){try{o=o||{};o.type=t;o.buffered=true;new PerformanceObserver(function(l){l.getEntries().forEach(f);}).observe(o);}catch(e){}}
  ob("largest-contentful-paint",function(x){if(!st)lcp=x.startTime;});
  ["keydown","pointerdown"].forEach(function(t){addEventListener(t,function(){st=1;},{once:true,capture:true});});
  ob("layout-shift",function(x){if(x.hadRecentInput)return;if(sv&&x.startTime-sl<1e3&&x.startTime-sf<5e3)sv+=x.value;else{sv=x.value;sf=x.startTime;}sl=x.startTime;if(!(sv<=cls))cls=sv;});
  ob("event",function(x){if(x.interactionId&&!(x.duration<=im[x.interactionId]))im[x.interactionId]=x.duration;},{durationThreshold:40});
  function vitals(o){
    var v=Object.keys(im).map(function(k){return im[k];}).sort(function(a,b){return b-a;});
    if(v.length)inp=v[Math.min(v.length-1,Math.floor(v.length/50))];
    if(lcp!=null)o.lcp_ms=Math.round(lcp);
    if(cls!=null)o.cls=Math.round(cls*1e4)/1e4;
    if(inp!=null)o.inp_ms=Math.round(inp);
    return o;
  }
  function flush(){
    tick();
    var body=JSON.stringify(vitals({type:"beacon",page_id:id,hostname:location.hostname,time_on_page:Math.round(acc/1000),scroll_depth:maxScroll}));
    if(body===lastSent)return;lastSent=body;
    if(navigator.sendBeacon){navigator.sendBeacon(EP,body);}
    else{send(JSON.parse(body)).catch(function(){});}
  }
  document.addEventListener("visibilitychange",function(){
    if(document.visibilityState==="hidden"){flush();visible=false;}
    else{visible=true;last=Date.now();}
  });
  window.addEventListener("pagehide",function(){flush();visible=false;});
  window.addEventListener("pageshow",function(e){if(e.persisted){visible=document.visibilityState==="visible";last=Date.now();}});
})();
</script>


<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Hreflang for i18n -->
<link rel="alternate" hreflang="it" href={itUrl} />
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="x-default" href={itUrl} />

<!-- RSS autodiscovery -->
<link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={optimizedDescription} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:locale" content={currentLang === "en" ? "en_US" : "it_IT"} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={optimizedDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content="Valerio Narcisi" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={optimizedDescription} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:creator" content="@valerionarcisi" />
<meta name="twitter:site" content="@valerionarcisi" />
