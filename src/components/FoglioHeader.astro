---
import DcFilters from "~/components/DcFilters.astro";
import { getCollection } from "astro:content";
import { getLangFromId, getSlugFromId } from "~/i18n/utils";
import { alternatePath, type Lang } from "~/lib/alt-lang";

interface Props {
  lang?: "it" | "en";
  active?: string;
}

const { lang = "it", active = "" } = Astro.props;

const isEn = lang === "en";

const links = [
  { id: "films", label: isEn ? "Films" : "Film", href: isEn ? "/en/films" : "/films" },
  { id: "code", label: isEn ? "Code" : "Codice", href: isEn ? "/en/code" : "/codice" },
  { id: "blog", label: "Blog", href: isEn ? "/en/blog" : "/blog" },
  { id: "watched", label: isEn ? "Watched" : "Visti", href: isEn ? "/en/watched" : "/visti" },
  { id: "listening", label: isEn ? "Listening" : "Ascolti", href: isEn ? "/en/listening" : "/ascolti" },
  { id: "about", label: isEn ? "About" : "Chi sono", href: isEn ? "/en/who-i-am" : "/who-i-am" },
  { id: "contact", label: isEn ? "Contact" : "Contatti", href: isEn ? "/en/contact" : "/contatti" },
];

const idsOf = async (collection: "blog" | "films") =>
  new Set((await getCollection(collection)).map((e) => `${getLangFromId(e.id)}/${getSlugFromId(e.id)}`));
const [blogIds, filmIds] = await Promise.all([idsOf("blog"), idsOf("films")]);
const langSwitchHref = alternatePath(Astro.url.pathname, lang as Lang, {
  blog: (l, slug) => blogIds.has(`${l}/${slug}`),
  films: (l, slug) => filmIds.has(`${l}/${slug}`),
});
const langSwitchLabel = isEn ? "IT" : "EN";
---

<DcFilters />
<header class="dc-header" id="dc-header">
  <div class="dc-header-inner">
    <a href={isEn ? "/en/" : "/"} class="dc-brand">Valerio Narcisi</a>
    <button type="button" class="dc-menu-btn" id="dc-menu-btn" aria-expanded="false" aria-controls="dc-nav">
      {isEn ? "Menu" : "Menu"}
    </button>
    <nav class="dc-nav" id="dc-nav" aria-label={isEn ? "Main" : "Principale"}>
      {links.map((link) => (
        <a href={link.href} aria-current={active === link.id ? "page" : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <a href={langSwitchHref} class="dc-lang" hreflang={isEn ? "it" : "en"} lang={isEn ? "it" : "en"}>{langSwitchLabel}</a>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.getElementById("dc-header");
    var btn = document.getElementById("dc-menu-btn");
    if (!header || !btn) return;
    header.classList.add("is-ready");
    btn.addEventListener("click", function () {
      var open = header.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
  })();
</script>

<style is:global>
  .dc-header {
    border-bottom: 1px solid var(--foglio-rule);
  }
  .dc-header-inner {
    max-width: var(--foglio-maxw);
    margin: 0 auto;
    padding: 8px var(--dc-gutter, 40px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 32px;
  }
  .dc-brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--dc-display, var(--foglio-sans));
    font-weight: 800;
    font-stretch: 125%;
    font-size: 15px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--foglio-ink);
  }
  .dc-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    font-family: var(--foglio-mono);
    font-size: 13px;
  }
  .dc-nav a,
  .dc-lang {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 4px;
    color: var(--foglio-ink);
  }
  .dc-nav a:hover,
  .dc-lang:hover {
    color: var(--foglio-accent);
  }
  .dc-nav a[aria-current="page"] {
    color: var(--foglio-accent);
  }
  .dc-lang {
    min-width: 44px;
    justify-content: center;
    border: 1px solid var(--foglio-rule-strong);
    font-family: var(--foglio-mono);
    font-size: 12px;
    color: var(--foglio-ink-soft);
  }
  .dc-menu-btn {
    display: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0 14px;
    background: transparent;
    border: 1px solid var(--foglio-rule-strong);
    color: var(--foglio-ink);
    font-family: var(--foglio-mono);
    font-size: 12px;
    cursor: pointer;
  }

  @media (max-width: 899px) {
    .dc-header-inner {
      gap: 0 12px;
    }
    .dc-brand {
      flex: 1 1 auto;
    }
    .dc-header.is-ready .dc-menu-btn {
      display: inline-flex;
      align-items: center;
    }
    .dc-nav {
      order: 5;
      flex-basis: 100%;
      flex-direction: column;
      gap: 0;
      padding: 8px 0 12px;
      border-top: 1px solid var(--foglio-rule);
    }
    .dc-header.is-ready:not(.is-open) .dc-nav {
      display: none;
    }
    .dc-nav a {
      min-height: 48px;
      font-size: 15px;
    }
  }
</style>
