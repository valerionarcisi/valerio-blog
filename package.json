{
  "name": "valerio-blog",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev --open",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write .",
    "check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/netlify": "^8.2.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/staatliches": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@libsql/client": "0.18.0",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "dompurify": "3.4.14",
    "isbot": "5.2.2",
    "marked": "18.0.11",
    "normalize.css": "^8.0.1",
    "sharp": "^0.35.5",
    "xml2js": "^0.6.2"
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "4.1.11"
  }
}
